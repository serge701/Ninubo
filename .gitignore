# Per-server configuration (secrets, DB credentials, base path) — template: includes/config.local.example.php
includes/config.local.php
.env

# Volcados de sendmail / logs locales
crash*.txt
*.log

# Archivos generados por el CRM (contratos firmados, logos subidos, caché de PDF, logs)
admin/storage/*
!admin/storage/.htaccess

# Respaldos / dumps que nunca deben subirse
*.sql.gz
*.bundle

# Logs de PHP que escribe el hosting (HostGator / LiteSpeed)
error_log
