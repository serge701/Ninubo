Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Internal folders are never served by URL (each also has its own "Require all denied").
RewriteRule ^(app|database|scripts|storage|vendor)(/|$) - [F,L]

# Real files (Tabler, app CSS/JS) are served as-is; everything else goes to the front controller.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]
RewriteRule ^ index.php [QSA,L]
