DirectoryIndex index.php index.html

# No listar el contenido de carpetas sin index.
Options -Indexes

# --- Archivos internos que no deben servirse por web ---------------------
# Notas de desarrollo, esquemas SQL, logs/volcados y cualquier .txt salvo
# robots.txt (p.ej. crash.txt de sendmail, assets/img/README.txt).
<FilesMatch "\.(md|sql|log|bak|ini|env|dist)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(?!robots\.txt$).+\.txt$">
    Require all denied
</FilesMatch>
# Archivos ocultos (.htaccess, .git, .env, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# --- Carpetas que solo se incluyen desde PHP, nunca por URL ---------------
# (includes/ y sql/ también tienen su propio .htaccess con "Require all
# denied" por si este bloque se pierde al subir el sitio.)
RedirectMatch 404 ^/(.*/)?(includes|sql)(/.*)?$
